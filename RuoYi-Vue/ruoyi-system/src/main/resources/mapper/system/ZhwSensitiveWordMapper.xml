<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.ZhwSensitiveWordMapper">

    <resultMap id="SensitiveWordResult" type="ZhwSensitiveWord">
        <id     property="id"         column="id"/>
        <result property="word"       column="word"/>
        <result property="category"   column="category"/>
        <result property="createBy"   column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy"   column="update_by"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <select id="selectList" parameterType="ZhwSensitiveWord" resultMap="SensitiveWordResult">
        SELECT id, word, category, create_by, create_time, update_by, update_time
        FROM zhw_sensitive_word
        <where>
            <if test="word != null and word != ''">
                AND word LIKE CONCAT('%', #{word}, '%')
            </if>
            <if test="category != null and category != ''">
                AND category = #{category}
            </if>
        </where>
        ORDER BY id DESC
    </select>

    <select id="selectById" resultMap="SensitiveWordResult">
        SELECT id, word, category, create_by, create_time, update_by, update_time
        FROM zhw_sensitive_word WHERE id = #{id}
    </select>

    <select id="selectAllWords" resultType="string">
        SELECT word FROM zhw_sensitive_word ORDER BY id
    </select>

    <insert id="insert" parameterType="ZhwSensitiveWord" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO zhw_sensitive_word (word, category, create_by, create_time)
        VALUES (#{word}, #{category}, #{createBy}, NOW())
    </insert>

    <update id="update" parameterType="ZhwSensitiveWord">
        UPDATE zhw_sensitive_word
        <set>
            <if test="word != null and word != ''">word = #{word},</if>
            <if test="category != null">category = #{category},</if>
            update_by = #{updateBy},
            update_time = NOW()
        </set>
        WHERE id = #{id}
    </update>

    <delete id="delete">
        DELETE FROM zhw_sensitive_word WHERE id = #{id}
    </delete>

</mapper>
