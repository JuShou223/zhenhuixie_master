{
  "name": "uni-app-starter",
  "version": "1.0.0",
  "scripts": {
    "lint": "eslint src --ext .vue,.js",
    "lint:fix": "eslint src --ext .vue,.js --fix",
    "dev:h5": "uni",
    "dev:mp-weixin": "uni -p mp-weixin",
    "dev:app": "uni -p app",
    "build:h5": "npm run lint && uni build",
    "build:mp-weixin": "npm run lint && uni build -p mp-weixin",
    "build:app": "npm run lint && uni build -p app",
    "postinstall": "weapp-tw patch"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-4080420251103001",
    "@dcloudio/uni-app-plus": "3.0.0-4080420251103001",
    "@dcloudio/uni-components": "3.0.0-4080420251103001",
    "@dcloudio/uni-h5": "3.0.0-4080420251103001",
    "@dcloudio/uni-mp-weixin": "3.0.0-4080420251103001",
    "mitt": "^3.0.1",
    "pinia": "^2.1.7",
    "uview-plus": "^3.6.18",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.8",
    "@dcloudio/uni-cli-shared": "3.0.0-4080420251103001",
    "@dcloudio/vite-plugin-uni": "3.0.0-4080420251103001",
    "autoprefixer": "^10.4.22",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.32.0",
    "postcss": "^8.5.6",
    "postcss-rem-to-responsive-pixel": "^6.1.0",
    "sass": "^1.63.2",
    "sass-loader": "^10.4.1",
    "tailwindcss": "^3.4.18",
    "vite": "5.2.8",
    "vite-plugin-eslint": "^1.8.1",
    "vite-plugin-remove-console": "^2.2.0",
    "weapp-tailwindcss": "^4.8.9"
  }
}
